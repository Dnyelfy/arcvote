const BS_API = 'https://testnet.arcscan.app/api/v2';
const j = (u) => fetch(u).then(r => { if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); });

async function pagedTxs(address, pages = 3) {
  let items = [], pp = null;
  for (let p = 0; p < pages; p++) {
    let url = `${BS_API}/addresses/${address}/transactions`;
    if (pp) url += '?' + new URLSearchParams(pp).toString();
    const page = await j(url);
    items = items.concat(page.items || []);
    if (!page.next_page_params) break;
    pp = page.next_page_params;
  }
  return items;
}

function calcStreak(dayTimes) {
  // dayTimes: array of ms timestamps of GM txs
  const days = new Set(dayTimes.map(t => Math.floor(t / 86400000)));
  const today = Math.floor(Date.now() / 86400000);
  let start = days.has(today) ? today : days.has(today - 1) ? today - 1 : null;
  if (start === null) return { streak: 0, today: days.has(today) };
  let s = 0, d = start;
  while (days.has(d)) { s++; d--; }
  return { streak: s, today: days.has(today) };
}

let questState = null;

async function verifyQuests() {
  if (!userAddress) { toast('Connect your wallet first!'); return; }
  const btn = document.getElementById('verifyBtn');
  btn.textContent = '⏳ Verifying…'; btn.disabled = true;
  try {
    const addr = userAddress;
    const [info, counters, txs] = await Promise.all([
      j(`${BS_API}/addresses/${addr}`),
      j(`${BS_API}/addresses/${addr}/counters`),
      pagedTxs(addr)
    ]);
    let nftCount = 0;
    try { const n = await j(`${BS_API}/addresses/${addr}/tokens?type=ERC-721`); nftCount = (n.items||[]).length; } catch {}

    const txCount = parseInt(counters.transactions_count || '0');
    const balance = info.coin_balance ? Number(info.coin_balance) / 1e18 : 0;
    const stamps = txs.map(t => new Date(t.timestamp).getTime()).filter(Boolean);
    const ageDays = stamps.length ? Math.max(1, Math.floor((Date.now() - Math.min(...stamps)) / 86400000)) : 0;

    const me = addr.toLowerCase();
    const out = txs.filter(t => t.from && t.from.hash && t.from.hash.toLowerCase() === me);
    const toIs = (c) => (t) => t.to && t.to.hash && t.to.hash.toLowerCase() === c.toLowerCase();
    const gmTimes = out.filter(toIs(GM_CONTRACT)).map(t => new Date(t.timestamp).getTime());
    const votedHere = out.some(toIs(VOTING_CONTRACT));
    const postedHere = out.some(toIs(BOARD_CONTRACT));
    const deployed = out.some(t => !t.to || (t.transaction_types || t.tx_types || []).includes('contract_creation'));
    const mset = new Set(out.map(t => String(t.method || '').toLowerCase()));
    const has = (...k) => [...mset].some(m => k.some(x => m.includes(x)));
    const didSwap = has('swap','exactinput','exactoutput','trade');
    const didBridge = has('bridge','depositfor','sendmessage','relay','burnlocked');
    const { streak, today } = calcStreak(gmTimes);

    const Q = [
      { ok: txCount >= 1,  xp: 5,  t: 'First transaction',            h: txCount>=1?`${txCount} txs total`:'Send any tx — your GM button is right here.', act: ['tab','gm'] },
      { ok: txCount >= 25, xp: 15, t: '25+ transactions',             h: `${txCount}/25 — volume is the base airdrop signal.`, act: ['tab','gm'] },
      { ok: ageDays >= 7,  xp: 10, t: 'Wallet age 7+ days',           h: `${ageDays} day(s) old — consistency beats bursts.` },
      { ok: streak >= 3,   xp: 10, t: 'GM streak 3+ days 🔥',         h: streak>=3?`Day ${streak} and counting`:`Current: ${streak}. Send GM daily — the pack button does it in one tap.`, act: ['tab','gm'] },
      { ok: votedHere,     xp: 10, t: 'Vote on a proposal',           h: votedHere?'Vote found on-chain ✓':'Cast one vote in the Vote tab.', act: ['tab','vote'] },
      { ok: postedHere,    xp: 10, t: 'Post on the message board',    h: postedHere?'Post found on-chain ✓':'Write anything in the Board tab.', act: ['tab','board'] },
      { ok: deployed,      xp: 15, t: 'Deploy a contract',            h: deployed?'Builder signal ✓':'Strongest signal there is — try zkcodex.', act: ['link','https://zkcodex.com'] },
      { ok: nftCount > 0,  xp: 10, t: 'Hold an NFT / Arc name',       h: nftCount>0?`${nftCount} collection(s) ✓`:'Mint at OmniHub or register an InfinityName.', act: ['link','https://omnihub.xyz'] },
      { ok: didSwap,       xp: 10, t: 'Make a swap',                  h: didSwap?'Swap detected ✓':'One DEX/FX swap on Arc covers it.' },
      { ok: didBridge,     xp: 10, t: 'Bridge assets',                h: didBridge?'Bridge detected ✓':'CCTP / thirdweb bridge in or out.', act: ['link','https://thirdweb.com/arc-testnet'] },
      { ok: balance >= 1,  xp: 5,  t: 'Keep 1+ USDC for gas',         h: `${balance.toFixed(2)} USDC in wallet.`, act: ['link','https://faucet.circle.com'] },
    ];
    const xp = Q.reduce((a,q)=>a+(q.ok?q.xp:0),0);
    const maxXp = Q.reduce((a,q)=>a+q.xp,0);
    const lvl = 1 + Math.floor(xp / 30);
    questState = { Q, xp, maxXp, lvl, streak, today, txCount };

    document.getElementById('streakBig').textContent = `🔥 Day ${streak}`;
    document.getElementById('streakSub').textContent = today ? 'GM sent today ✓ · verified from chain' : 'No GM yet today — keep the flame alive!';
    document.getElementById('lvlNum').textContent = lvl;
    document.getElementById('xpNum').textContent = xp;
    document.getElementById('xpBar').style.width = (xp / maxXp * 100).toFixed(0) + '%';
    document.getElementById('xpSub').textContent = `${Q.filter(q=>q.ok).length}/${Q.length} quests complete · ${maxXp - xp} XP left on the table`;

    document.getElementById('questList').innerHTML = Q.map(q => `
      <div class="card" style="display:flex;align-items:center;gap:14px;padding:14px 18px;${q.ok?'border-color:var(--green-border);':''}">
        <span style="font-size:18px;flex-shrink:0;">${q.ok ? '✅' : '⬜'}</span>
        <div style="flex:1;min-width:0;">
          <div style="font-size:14px;font-weight:700;">${q.t} <span style="font-size:10px;font-family:var(--mono);color:${q.ok?'var(--green)':'var(--muted)'};">+${q.xp} XP</span></div>
          <div style="font-size:11.5px;color:var(--muted);font-family:var(--mono);margin-top:3px;">${q.h}</div>
        </div>
        ${!q.ok && q.act ? (q.act[0]==='tab'
          ? `<button class="connect-btn" onclick="goTab('${q.act[1]}')">Do it →</button>`
          : `<a class="connect-btn" style="text-decoration:none;" href="${q.act[1]}" target="_blank">Open ↗</a>`) : ''}
      </div>`).join('');
    toast('✓ Verified from chain');
  } catch (e) {
    toast('Verify failed: ' + (e.message || '').slice(0, 60));
  } finally {
    btn.textContent = '↻ Verify from chain'; btn.disabled = false;
  }
}
window.verifyQuests = verifyQuests;
