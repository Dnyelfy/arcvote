async function dailyPack() {
  if (!isConnected) { toast('Connect your wallet first!'); return; }
  const btn = document.getElementById('dailyBtn');
  btn.disabled = true; btn.textContent = '⏳ 1/2 GM…';
  try {
    const gmC = new Contract(GM_CONTRACT, GM_ABI, signer);
    const tx1 = await gmC.gm();
    await tx1.wait();
    pushTx('gm', 'Daily pack: GM sent', tx1.hash);
    toast('☀️ GM on-chain (1/2)');

    btn.textContent = '⏳ 2/2 Vote…';
    const open = proposals.find(p => !p.voted);
    if (open) {
      const vC = new Contract(VOTING_CONTRACT, VOTING_ABI, signer);
      const tx2 = await vC.vote(open.id - 1, 0);
      await tx2.wait();
      open.voted = 'yes'; open.yes++; open.txHash = tx2.hash;
      saveProposals(); renderProposals();
      pushTx('vote', 'Daily pack: voted YES on #' + open.id, tx2.hash);
      toast('🗳 Vote on-chain (2/2)');
    } else {
      toast('All proposals already voted — GM was enough today ✓');
    }
    renderGmFeed(); fetchBalance(); updateStats();
    await verifyQuests();
    toast('⚡ Daily pack complete!');
  } catch (e) {
    toast('Pack stopped: ' + (e.message || '').slice(0, 60));
  } finally {
    btn.disabled = false; btn.textContent = '⚡ Do my daily pack';
  }
}
window.dailyPack = dailyPack;

async function loadLeaderboard() {
  const el = document.getElementById('lbList');
  const btn = document.getElementById('lbBtn');
  if (btn) { btn.disabled = true; }
  el.innerHTML = '<p class="empty">Reading GM contract activity…</p>';
  try {
    const txs = await pagedTxs(GM_CONTRACT, 3);
    const tally = {};
    for (const t of txs) {
      const f = t.from && t.from.hash ? t.from.hash.toLowerCase() : null;
      if (f) tally[f] = (tally[f] || 0) + 1;
    }
    const rows = Object.entries(tally).sort((a,b)=>b[1]-a[1]).slice(0,10);
    if (!rows.length) { el.innerHTML = '<p class="empty">No GM activity found yet.</p>'; return; }
    const medals = ['🥇','🥈','🥉'];
    el.innerHTML = rows.map(([a,c],i) => {
      const you = userAddress && a === userAddress.toLowerCase();
      return `<div style="display:flex;align-items:center;gap:12px;padding:10px 6px;border-bottom:0.5px solid var(--border);${you?'background:var(--green-bg);border-radius:8px;':''}">
        <span style="width:30px;text-align:center;font-size:${i<3?'17px':'12px'};font-family:var(--mono);color:var(--muted);">${medals[i]||'#'+(i+1)}</span>
        <a href="https://testnet.arcscan.app/address/${a}" target="_blank" style="flex:1;font-family:var(--mono);font-size:12.5px;color:${you?'var(--green)':'var(--text)'};text-decoration:none;">${a.slice(0,8)}…${a.slice(-6)}${you?' (you)':''}</a>
        <span style="font-family:var(--mono);font-size:13px;font-weight:700;color:var(--accent);">${c} GM</span>
      </div>`;
    }).join('') + `<p style="font-size:10px;color:var(--dim);font-family:var(--mono);margin-top:10px;">Based on latest ${txs.length} GM-contract txs · refresh for live data</p>`;
  } catch (e) {
    el.innerHTML = '<p class="empty">Leaderboard unavailable: ' + (e.message || '') + '</p>';
  } finally {
    if (btn) btn.disabled = false;
  }
}
window.loadLeaderboard = loadLeaderboard;
loadLeaderboard();

