    <div id="questList"><p class="empty">Connect your wallet to load your quests.</p></div>

    <div class="card" style="border-style:dashed;">
      <span style="font-size:12px;color:var(--muted);font-family:var(--mono);">Want the full diagnosis? → <a href="https://arc-wallet-check.vercel.app" target="_blank" style="color:var(--accent);text-decoration:none;font-weight:700;">⚡ Arc Wallet Check</a> — score, heatmap & report for any address.</span>
    </div>
