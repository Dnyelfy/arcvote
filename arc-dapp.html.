    <div id="proposalList"></div>
  </div>

  <!-- GM -->
  <div class="section" id="gm">
    <div class="gm-grid">
      <div class="gm-card gm-t off" id="gmCard" onclick="sendOnchain('GM')">
        <span class="gm-emoji">☀️</span>
        <div class="gm-label">GM</div>
        <div class="gm-sub">good morning · on-chain</div>
      </div>
      <div class="gm-card gn-t off" id="gnCard" onclick="sendOnchain('GN')">
        <span class="gm-emoji">🌙</span>
        <div class="gm-label">GN</div>
        <div class="gm-sub">good night · on-chain</div>
      </div>
    </div>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;font-family:var(--mono);">Live feed</span>
        <span style="font-size:11px;color:var(--dim);font-family:var(--mono);" id="gmCount">0 messages</span>
      </div>
      <div id="gmFeed"><p class="empty">No messages yet. Connect wallet & send your first GM ☀️</p></div>
    </div>
  </div>

  <!-- TX LOG -->
  <div class="section" id="txlog">
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;font-family:var(--mono);">Transaction history</span>
        <a href="https://testnet.arcscan.app" target="_blank" style="font-size:11px;color:var(--accent);font-family:var(--mono);text-decoration:none;">ArcScan ↗</a>
      </div>
      <div id="txLogList"><p class="empty">No transactions yet.</p></div>
    </div>
  </div>
  <!-- BOARD -->
  <div class="section" id="board">
    <div class="new-proposal-card">
      <span class="np-label">📝 Post a message on-chain</span>
      <textarea class="text-input" id="boardMsg" rows="3" placeholder="Write anything — permanently stored on Arc blockchain..."></textarea>
      <button class="submit-btn" id="boardBtn" onclick="postBoardMsg()" disabled>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9-9-4 20-7z"/></svg>
        Post on-chain
      </button>
      <p style="font-size:11px;color:var(--muted);margin-top:8px;font-family:var(--mono);">Message is permanently stored on Arc · Gas ~$0.009 USDC</p>
    </div>
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;font-family:var(--mono);">Message board</span>
        <span style="font-size:11px;color:var(--dim);font-family:var(--mono);" id="boardCount">0 messages</span>
      </div>
      <div id="boardList"><p class="empty">No messages yet. Be the first to post!</p></div>
    </div>
  </div>

  <div style="height:40px;"></div>
</div>

<footer>
  <div class="container">
    <div class="footer-inner">
      <span class="footer-l">Built by <a href="https://x.com/dnyelfy" target="_blank" style="color:var(--accent);text-decoration:none;">@dnyelfy</a> · Arc Testnet · Chain ID 5042002</span>
      <div class="footer-links">
        <a href="https://arc-wallet-check.vercel.app" target="_blank" style="color:var(--accent);font-weight:600;">⚡ Wallet Check</a>
        <a href="https://docs.arc.io" target="_blank">Docs</a>
        <a href="https://faucet.circle.com" target="_blank">Faucet</a>
        <a href="https://testnet.arcscan.app" target="_blank">Explorer</a>
        <a href="https://discord.com/invite/buildonarc" target="_blank">Discord</a>
      </div>
    </div>
  </div>
</footer>

<div class="toast-wrap"><div class="toast" id="toast"></div></div>

<script type="module">
import { createWeb3Modal, defaultConfig } from 'https://esm.sh/@web3modal/ethers@4.2.3';
import { BrowserProvider, formatUnits, Contract } from 'https://esm.sh/ethers@6.7.1';

/* ── CONFIG ── */
const PROJECT_ID = '65f38a70090f3dfcc7d06364559626b3';

const arcTestnet = {
  chainId: 5042002,
  name: 'Arc Testnet',
  currency: 'USDC',
  explorerUrl: 'https://testnet.arcscan.app',
  rpcUrl: 'https://rpc.testnet.arc.network',
};

const metadata = {
  name: 'ArcVote',
  description: 'Onchain governance on Arc Network',
  url: 'https://arcvote.app',
  icons: ['https://arcvote.app/icon.png'],
};

const modal = createWeb3Modal({
  ethersConfig: defaultConfig({ metadata }),
  chains: [arcTestnet],
  projectId: PROJECT_ID,
  themeMode: 'dark',
  themeVariables: {
    '--w3m-accent': '#5b6bff',
    '--w3m-border-radius-master': '8px',
    '--w3m-font-family': 'Syne, sans-serif',
  },
  featuredWalletIds: [
    'c57ca95b47569778a828d19178114f4db188b89b763c899ba0be274e97267d96', // MetaMask
    'a797aa35c0fadbfc1a53e7f675162ed5226968b44a19ee3d24385c64d1d3c393', // Phantom
    'fd20dc426fb37566d803205b19bbc1d4096b248ac04548e3cfb6b3a38bd033aa', // Coinbase
    '4622a2b2d6af1c9844944291e5e7351a6aa24cd7b23099efac1b2fd875da31a0', // Trust
    '1ae92b26df02f0abca6304df07debccd18262fdf5fe82daa81593582dac9a369', // Rainbow
  ],
});

/* ── ARC CONFIG ── */
const EXPLORER = 'https://testnet.arcscan.app';
const VOTING_CONTRACT = '0x8E3e06574B413915c1D7B6d0EE9EF67bca4dB29c';
const GM_CONTRACT = '0xb94918f7e3f7b3d4Ad44d19Fee5CcDb2403F41a1';
const BOARD_CONTRACT = '0xb21972fC3F5Bf13E883F1590D97e1CFabCF36514';
const BOARD_ABI = [
  'function post(string calldata text) external',
  'event Message(address indexed sender, string text, uint256 timestamp)',
];
const VOTING_ABI = [
  'function addProposal(string calldata text) external',
  'function vote(uint256 proposalId, uint8 option) external',
  'function proposalCount() external view returns (uint256)',
  'function getProposal(uint256 id) external view returns (tuple(string text, address proposer, uint256 yesVotes, uint256 noVotes, uint256 abstainVotes, uint256 createdAt))',
  'function hasVoted(address voter, uint256 proposalId) external view returns (bool)',
  'event ProposalAdded(uint256 indexed id, string text, address indexed proposer)',
  'event Voted(address indexed voter, uint256 indexed proposalId, uint8 option)',
];
const GM_ABI = [
  'function gm() external',
  'function gn() external',
  'event Message(address indexed sender, string msg, uint256 timestamp)',
];

/* ── STATE ── */
let provider, signer, userAddress, isConnected = false;
const STORAGE_KEY = 'arcvote_v3';

function loadProposals() {
  try { const s = localStorage.getItem(STORAGE_KEY); return s ? JSON.parse(s) : defaultProposals(); }
  catch { return defaultProposals(); }
}
function saveProposals() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(proposals)); } catch {}
}
function defaultProposals() {
  return [
    { id:1, text:'Should Arc adopt ERC-4337 account abstraction as the default wallet standard?', yes:18, no:4, abs:2, tag:'Standard', voted:null, txHash:null },
    { id:2, text:'USDC gas makes dApp development significantly easier than ETH-based gas.', yes:27, no:3, abs:1, tag:'UX', voted:null, txHash:null },
    { id:3, text:'The voting contract should be written in Solidity rather than Vyper.', yes:9, no:13, abs:5, tag:'Dev', voted:null, txHash:null },
  ];
}

let proposals = loadProposals();
let txLog = [], gmFeed = [];
let nextId = Math.max(...proposals.map(p => p.id)) + 1;

/* ── WALLET EVENTS ── */
modal.subscribeProvider(async ({ provider: p, address, isConnected: ic }) => {
  if (ic && p && address) {
    provider = new BrowserProvider(p);
    signer = await provider.getSigner();
    userAddress = address;
    isConnected = true;
    fetchBalance();
    document.getElementById('balChip').style.display = 'inline-flex';
    enableActions();
    toast('✓ Connected to Arc Testnet!');
    loadFromChain();
  } else {
    isConnected = false;
    document.getElementById('balChip').style.display = 'none';
    disableActions();
  }
});

async function fetchBalance() {
  try {
    const bal = await provider.getBalance(userAddress);
    const f = parseFloat(formatUnits(bal, 18)).toFixed(4);
    document.getElementById('balChip').textContent = f + ' USDC';
  } catch {}
}

/* ── LOAD FROM CHAIN ── */
async function loadFromChain() {
  if (!provider) return;
  try {
    // Load proposals from contract
    const votingContract = new Contract(VOTING_CONTRACT, VOTING_ABI, provider);
    const count = await votingContract.proposalCount();
    const countNum = Number(count);
    if (countNum > 0) {
      const chainProposals = [];
      for (let i = 0; i < Math.min(countNum, 20); i++) {
        try {
          const p = await votingContract.getProposal(i);
          const voted = userAddress ? await votingContract.hasVoted(userAddress, i) : false;
          // Find if user voted (check localStorage for which option)
          const localVote = proposals.find(lp => lp.id === i + 1);
          chainProposals.push({
            id: i + 1,
            text: p.text,
            yes: Number(p.yesVotes),
            no: Number(p.noVotes),
            abs: Number(p.abstainVotes),
            tag: localVote?.tag || 'On-chain',
            voted: voted ? (localVote?.voted || 'yes') : null,
            txHash: localVote?.txHash || null,
          });
        } catch(e) {}
      }
      if (chainProposals.length > 0) {
        proposals = chainProposals;
        nextId = chainProposals.length + 1;
        renderProposals();
        toast('✓ Loaded ' + chainProposals.length + ' proposals from chain');
      }
    }
  } catch(e) {
    console.log('Chain load error:', e.message);
  }

  try {
    // Load GM/GN events from contract
    const gmContract = new Contract(GM_CONTRACT, GM_ABI, provider);
    const filter = gmContract.filters.Message();
    const currentBlock = await provider.getBlockNumber();
    const fromBlock = Math.max(0, currentBlock - 50000);
    const events = await gmContract.queryFilter(filter, fromBlock, 'latest');
    if (events.length > 0) {
      gmFeed = events.reverse().slice(0, 20).map(e => ({
        type: e.args.msg,
        hash: e.transactionHash,
        time: new Date(Number(e.args.timestamp) * 1000).toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'}),
      }));
      renderGmFeed();
    }
  } catch(e) {
    console.log('GM load error:', e.message);
  }

  // Load board messages from chain
  await loadBoardFromChain();
}

function enableActions() {
  document.getElementById('submitPropBtn').disabled = false;
  if(document.getElementById('boardBtn')) document.getElementById('boardBtn').disabled = false;
  document.getElementById('gmCard').classList.remove('off');
  document.getElementById('gnCard').classList.remove('off');
  document.getElementById('dailyBtn').disabled = false;
  renderProposals();
  verifyQuests();
}
function disableActions() {
  document.getElementById('submitPropBtn').disabled = true;
  document.getElementById('gmCard').classList.add('off');
  document.getElementById('gnCard').classList.add('off');
  document.getElementById('dailyBtn').disabled = true;
  renderProposals();
}

/* ── TRANSACTIONS ── */
async function sendOnchain(type) {
  if (!isConnected) { toast('Connect your wallet first!'); return; }
  const card = document.getElementById(type === 'GM' ? 'gmCard' : 'gnCard');
  card.classList.add('off');
  try {
    let txHash;
    if (GM_CONTRACT) {
      const contract = new Contract(GM_CONTRACT, GM_ABI, signer);
      const tx = await (type === 'GM' ? contract.gm() : contract.gn());
      toast('⏳ ' + type + ' TX submitted...');
      await tx.wait();
      txHash = tx.hash;
    } else {
      const tx = await signer.sendTransaction({ to: userAddress, value: '0x0' });
      toast('⏳ ' + type + ' TX submitted...');
      await tx.wait();
      txHash = tx.hash;
    }
    gmFeed.unshift({ type, hash: txHash, time: timeNow() });
    pushTx(type.toLowerCase(), type + ' message sent on-chain', txHash);
    renderGmFeed();
    fetchBalance();
    toast('✓ ' + type + '! Confirmed on Arc');
  } catch(e) {
    toast('Failed: ' + (e.message || '').slice(0, 70));
  } finally {
    card.classList.remove('off');
  }
}
window.sendOnchain = sendOnchain;

async function castVote(id, opt) {
  if (!isConnected) { toast('Connect your wallet first!'); return; }
  const p = proposals.find(x => x.id === id);
  if (!p || p.voted) { toast('Already voted on this.'); return; }
  const optNum = opt === 'yes' ? 0 : opt === 'no' ? 1 : 2;
  try {
    let txHash;
    if (VOTING_CONTRACT) {
      const contract = new Contract(VOTING_CONTRACT, VOTING_ABI, signer);
      const tx = await contract.vote(id - 1, optNum);
      toast('⏳ Vote TX submitted...');
      await tx.wait();
      txHash = tx.hash;
    } else {
      const tx = await signer.sendTransaction({ to: userAddress, value: '0x0' });
      toast('⏳ Vote TX submitted...');
      await tx.wait();
      txHash = tx.hash;
    }
    p.voted = opt;
    p[opt === 'yes' ? 'yes' : opt === 'no' ? 'no' : 'abs']++;
    p.txHash = txHash;
    saveProposals();
    pushTx('vote', 'Voted "' + opt + '" on: ' + p.text.slice(0,40) + '...', txHash);
    renderProposals();
    fetchBalance();
    toast('✓ Vote confirmed on Arc!');
  } catch(e) {
    toast('Vote failed: ' + (e.message || '').slice(0, 70));
  }
}
window.castVote = castVote;

async function submitProposal() {
  if (!isConnected) { toast('Connect your wallet first!'); return; }
  const inp = document.getElementById('proposalInput');
  const text = inp.value.trim();
  if (!text) { toast('Please enter a proposal.'); return; }
  const btn = document.getElementById('submitPropBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spin"></span> Submitting...';
  try {
    let txHash;
    if (VOTING_CONTRACT) {
      const contract = new Contract(VOTING_CONTRACT, VOTING_ABI, signer);
      const tx = await contract.addProposal(text);
      toast('⏳ Proposal TX submitted...');
      await tx.wait();
      txHash = tx.hash;
    } else {
      const tx = await signer.sendTransaction({ to: userAddress, value: '0x0' });
      toast('⏳ Proposal TX submitted...');
      await tx.wait();
      txHash = tx.hash;
    }
    proposals.unshift({ id: nextId++, text, yes:0, no:0, abs:0, tag:'New', voted:null, txHash });
    inp.value = '';
    saveProposals();
    pushTx('proposal', 'New proposal: "' + text.slice(0,40) + '..."', txHash);
    renderProposals();
    fetchBalance();
    toast('✓ Proposal submitted on-chain!');
  } catch(e) {
    toast('Failed: ' + (e.message || '').slice(0, 70));
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Submit on-chain';
  }
}
window.submitProposal = submitProposal;

/* ── RENDER ── */
function renderProposals() {
  const el = document.getElementById('proposalList');
  el.innerHTML = proposals.map(p => {
    const total = p.yes + p.no + p.abs || 1;
    const yesPct = Math.round(p.yes / total * 100);
    const noPct = Math.round(p.no / total * 100);
    const txLink = p.txHash ? `<a class="tx-link" href="${EXPLORER}/tx/${p.txHash}" target="_blank">on-chain ↗</a>` : '';
    const dis = !isConnected || p.voted ? 'disabled' : '';
    return `<div class="card">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap;">
        <span class="prop-tag">${p.tag}</span>
        ${p.voted ? `<span class="voted-badge">✓ Voted</span>${txLink}` : ''}
      </div>
      <p class="prop-text">${p.text}</p>
      <div class="bar-labels"><span>Yes ${yesPct}%</span><span>No ${noPct}%</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:${yesPct}%"></div></div>
      <div class="bar-sub">${p.yes+p.no+p.abs} votes · abstain: ${p.abs}</div>
      <div class="vote-actions">
        <button class="vote-action ${p.voted==='yes'?'voted-yes':''}" onclick="castVote(${p.id},'yes')" ${dis}>👍 Yes</button>
        <button class="vote-action ${p.voted==='no'?'voted-no':''}" onclick="castVote(${p.id},'no')" ${dis}>👎 No</button>
        <button class="vote-action ${p.voted==='abs'?'voted-abs':''}" onclick="castVote(${p.id},'abs')" ${dis}>— Abstain</button>
      </div>
    </div>`;
  }).join('');
  updateStats();
}

function renderGmFeed() {
  const el = document.getElementById('gmFeed');
  document.getElementById('gmCount').textContent = gmFeed.length + ' message' + (gmFeed.length !== 1 ? 's' : '');
  if (!gmFeed.length) { el.innerHTML = '<p class="empty">No messages yet. Connect wallet & send your first GM ☀️</p>'; return; }
  el.innerHTML = gmFeed.slice(0,12).map(e => `
    <div class="feed-item">
      <div class="feed-av ${e.type.toLowerCase()}">${e.type==='GM'?'☀️':'🌙'}</div>
      <div class="feed-body">
        <div class="feed-msg">${e.type} · ${e.time}</div>
        <div class="feed-hash"><a href="${EXPLORER}/tx/${e.hash}" target="_blank">${e.hash.slice(0,20)}...</a></div>
      </div>
      <div class="feed-time">${e.time}</div>
    </div>`).join('');
}

function renderTxLog() {
  const el = document.getElementById('txLogList');
  if (!txLog.length) { el.innerHTML = '<p class="empty">No transactions yet.</p>'; return; }
  el.innerHTML = txLog.slice(0,15).map(tx => `
    <div class="tx-row">
      <div class="tx-pill ${tx.type}">${tx.type.toUpperCase()}</div>
      <div class="tx-desc">${tx.desc}</div>
      <a class="tx-hash-link" href="${EXPLORER}/tx/${tx.hash}" target="_blank">${tx.hash.slice(0,12)}...</a>
      <div class="tx-dot"></div>
    </div>`).join('');
}

function pushTx(type, desc, hash) {
  txLog.unshift({ type, desc, hash, time: timeNow() });
  renderTxLog();
  updateStats();
}

function updateStats() {
  const total = proposals.reduce((s,p) => s+p.yes+p.no+p.abs, 0);
  document.getElementById('hTotalVotes').textContent = total;
  document.getElementById('hTotalTx').textContent = txLog.length;
  document.getElementById('sProposals').textContent = proposals.length;
  document.getElementById('sMyVotes').textContent = proposals.filter(p => p.voted).length;
  document.getElementById('sTotalVotes').textContent = total;
}

function timeNow() { return new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}); }

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => t.classList.remove('show'), 3000);
}
window.toast = toast;

function shareOnX() {
  const txt = encodeURIComponent('Just voted onchain on @arcnetwork 🗳️\n\nUSDC-native L1 — gas ~$0.009 per tx. Sub-second finality.\n\nTry it 👇');
  const url = encodeURIComponent('https://arcvote.app');
  window.open(`https://twitter.com/intent/tweet?text=${txt}&url=${url}&hashtags=ArcNetwork,USDC,Web3`,'_blank');
}
window.shareOnX = shareOnX;
