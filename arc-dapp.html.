let boardMessages = JSON.parse(localStorage.getItem('arc_board_v1') || '[]');

async function postBoardMsg() {
  if (!isConnected) { toast('Connect your wallet first!'); return; }
  const msg = document.getElementById('boardMsg').value.trim();
  if (!msg) { toast('Please write a message!'); return; }
  if (msg.length > 280) { toast('Max 280 characters!'); return; }

  const btn = document.getElementById('boardBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spin"></span> Posting...';

  try {
    const contract = new Contract(BOARD_CONTRACT, BOARD_ABI, signer);
    const tx = await contract.post(msg);
    toast('⏳ Posting message on Arc...');
    await tx.wait();

    const entry = {
      msg,
      addr: userAddress,
      short: userAddress.slice(0,6)+'...'+userAddress.slice(-4),
      hash: tx.hash,
      time: new Date().toLocaleString('en-US', {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})
    };
    boardMessages.unshift(entry);
    localStorage.setItem('arc_board_v1', JSON.stringify(boardMessages));
    pushTx('vote', 'Board: "' + msg.slice(0,40) + (msg.length>40?'...':'') + '"', tx.hash);
    // Reload from chain
    await loadBoardFromChain();
    fetchBalance();
    document.getElementById('boardMsg').value = '';
    toast('✓ Message posted on Arc!');
  } catch(e) {
    toast('Failed: ' + (e.message||'').slice(0,60));
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2L15 22l-4-9-9-4 20-7z"/></svg> Post on-chain';
  }
}
window.postBoardMsg = postBoardMsg;

async function loadBoardFromChain() {
  if (!provider) return;
  try {
    const boardContract = new Contract(BOARD_CONTRACT, BOARD_ABI, provider);
    const filter = boardContract.filters.Message();
    const currentBlock = await provider.getBlockNumber();
    const fromBlock = Math.max(0, currentBlock - 100000);
    const events = await boardContract.queryFilter(filter, fromBlock, 'latest');
    if (events.length > 0) {
      boardMessages = events.reverse().slice(0, 30).map(e => ({
        msg: e.args.text,
        addr: e.args.sender,
        short: e.args.sender.slice(0,6)+'...'+e.args.sender.slice(-4),
        hash: e.transactionHash,
        time: new Date(Number(e.args.timestamp) * 1000).toLocaleString('en-US', {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}),
      }));
      localStorage.setItem('arc_board_v1', JSON.stringify(boardMessages));
      renderBoard();
    }
  } catch(e) {
    console.log('Board load error:', e.message);
  }
}

function renderBoard() {
  const el = document.getElementById('boardList');
