<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>ArcVote — Arc Quest Hub: Verify Your Testnet Tasks On-chain</title>
<meta property="og:title" content="ArcVote — Onchain Governance"/>
<meta property="og:description" content="Track & verify every Arc testnet task on-chain: quests, XP, GM streaks, leaderboard, daily tx pack. Built on Arc — USDC-native L1."/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="ArcVote — Onchain Governance on Arc"/>
<meta name="twitter:description" content="Track & verify every Arc testnet task on-chain: quests, XP, GM streaks, leaderboard, daily tx pack. Built on Arc — USDC-native L1."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0a0f;--bg2:#111118;--bg3:#16161f;
  --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);
  --text:#f0eff8;--muted:#7c7b8f;--dim:#3a394a;
  --accent:#5b6bff;--accent2:#7c4dff;--accent-glow:rgba(91,107,255,0.18);
  --green:#1de9b6;--green-bg:rgba(29,233,182,0.08);--green-border:rgba(29,233,182,0.25);
  --amber:#ffc107;--amber-bg:rgba(255,193,7,0.08);
  --red:#ff5252;--red-bg:rgba(255,82,82,0.08);
  --font:'Syne',sans-serif;--mono:'DM Mono',monospace;
}
html{background:var(--bg);color:var(--text);font-family:var(--font);}
body{min-height:100vh;display:flex;flex-direction:column;}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:0;opacity:0.5;}
.blob1{position:fixed;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(91,107,255,0.12) 0%,transparent 70%);top:-200px;right:-100px;pointer-events:none;z-index:0;}
.blob2{position:fixed;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(124,77,255,0.08) 0%,transparent 70%);bottom:-200px;left:-100px;pointer-events:none;z-index:0;}
.container{max-width:780px;margin:0 auto;padding:0 24px;position:relative;z-index:1;}

header{padding:22px 0;border-bottom:0.5px solid var(--border);position:sticky;top:0;background:rgba(10,10,15,0.88);backdrop-filter:blur(20px);z-index:100;}
.header-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo-mark{width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.logo-mark svg{width:18px;height:18px;}
.logo-text{font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.5px;}
.logo-text span{color:var(--accent);}
.header-right{display:flex;align-items:center;gap:10px;}
.net-pill{display:flex;align-items:center;gap:6px;padding:5px 11px;border-radius:99px;background:var(--bg3);border:0.5px solid var(--border2);font-size:11px;font-family:var(--mono);color:var(--muted);}
.dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.bal-chip{font-size:11px;font-family:var(--mono);color:var(--green);background:var(--green-bg);border:0.5px solid var(--green-border);padding:5px 11px;border-radius:99px;display:none;}
.connect-btn{padding:8px 18px;border-radius:8px;border:0.5px solid var(--border2);background:var(--bg3);color:var(--text);font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
.connect-btn:hover{background:var(--accent-glow);border-color:var(--accent);color:#fff;}
.connect-btn.connected{border-color:var(--green);color:var(--green);background:var(--green-bg);font-family:var(--mono);font-size:11px;}

/* Web3Modal override — dark theme matching */
w3m-button{--w3m-accent:#5b6bff;}

.hero{padding:48px 0 40px;}
.eyebrow{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-family:var(--mono);color:var(--accent);letter-spacing:0.12em;text-transform:uppercase;padding:5px 12px;border-radius:99px;background:var(--accent-glow);border:0.5px solid rgba(91,107,255,0.3);margin-bottom:18px;}
.hero h1{font-size:clamp(32px,5.5vw,50px);font-weight:800;line-height:1.07;letter-spacing:-1.5px;margin-bottom:14px;}
.hero h1 em{font-style:normal;color:var(--accent);}
.hero p{font-size:15px;color:var(--muted);line-height:1.65;max-width:500px;}
.hero-stats{display:flex;gap:28px;margin-top:28px;flex-wrap:wrap;}
.hstat-n{font-size:21px;font-weight:700;color:var(--text);font-family:var(--mono);letter-spacing:-0.5px;}
.hstat-l{font-size:11px;color:var(--muted);margin-top:2px;text-transform:uppercase;letter-spacing:0.08em;}

.share-strip{background:linear-gradient(135deg,rgba(91,107,255,0.1),rgba(124,77,255,0.08));border:0.5px solid rgba(91,107,255,0.22);border-radius:12px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;gap:14px;flex-wrap:wrap;}
.share-text{font-size:14px;color:var(--text);}
.share-text span{color:var(--muted);font-size:11px;font-family:var(--mono);display:block;margin-top:3px;}
.tweet-btn{padding:9px 18px;border-radius:8px;border:none;background:#1d9bf0;color:#fff;font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;transition:opacity 0.2s,transform 0.15s;flex-shrink:0;}
.tweet-btn:hover{opacity:0.85;transform:translateY(-1px);}
.tweet-btn svg{width:14px;height:14px;fill:white;}

.tabs-wrap{margin-bottom:24px;}
.tabs{display:flex;gap:3px;padding:4px;background:var(--bg2);border:0.5px solid var(--border);border-radius:10px;width:fit-content;}
.tab-btn{padding:8px 18px;border-radius:7px;border:none;background:transparent;color:var(--muted);font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:6px;}
.tab-btn svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.tab-btn.active{background:var(--bg3);color:var(--text);border:0.5px solid var(--border2);}
.tab-btn:hover:not(.active){color:var(--text);}
.section{display:none;animation:fadeIn 0.22s ease;}
.section.active{display:block;}.modal-overlay.open{display:flex!important;}
@keyframes fadeIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}

.card{background:var(--bg2);border:0.5px solid var(--border);border-radius:14px;padding:20px 22px;margin-bottom:14px;transition:border-color 0.2s;}
.card:hover{border-color:var(--border2);}
.stats-bar{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:24px;}
.stat-card{background:var(--bg2);border:0.5px solid var(--border);border-radius:12px;padding:14px 16px;}
.stat-n{font-size:22px;font-weight:700;color:var(--text);font-family:var(--mono);letter-spacing:-0.5px;}
.stat-l{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-top:3px;}

.new-proposal-card{background:var(--bg2);border:0.5px dashed var(--border2);border-radius:14px;padding:20px 22px;margin-bottom:14px;}
.np-label{font-size:11px;color:var(--muted);font-family:var(--mono);text-transform:uppercase;letter-spacing:0.1em;display:block;margin-bottom:10px;}
.text-input{width:100%;padding:11px 14px;border-radius:8px;border:0.5px solid var(--border2);background:var(--bg3);color:var(--text);font-family:var(--font);font-size:14px;outline:none;transition:border-color 0.2s;resize:none;}
.text-input::placeholder{color:var(--dim);}
.text-input:focus{border-color:var(--accent);}
.submit-btn{margin-top:10px;padding:10px 20px;border-radius:8px;border:none;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;transition:opacity 0.2s,transform 0.15s;display:inline-flex;align-items:center;gap:7px;}
.submit-btn:hover:not(:disabled){opacity:0.87;transform:translateY(-1px);}
.submit-btn:disabled{opacity:0.45;cursor:not-allowed;}

.prop-tag{font-size:10px;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.1em;padding:3px 9px;border-radius:99px;background:var(--accent-glow);color:var(--accent);border:0.5px solid rgba(91,107,255,0.25);}
.voted-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-family:var(--mono);color:var(--green);background:var(--green-bg);border:0.5px solid var(--green-border);padding:3px 9px;border-radius:99px;margin-left:6px;}
.prop-text{font-size:14px;line-height:1.55;color:var(--text);margin:10px 0 14px;}
.bar-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);font-family:var(--mono);margin-bottom:5px;}
.bar-track{height:5px;background:var(--bg3);border-radius:99px;overflow:hidden;border:0.5px solid var(--border);}
.bar-fill{height:5px;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--green));transition:width 0.5s cubic-bezier(0.4,0,0.2,1);}
.bar-sub{font-size:11px;color:var(--dim);font-family:var(--mono);margin-top:5px;}
.vote-actions{display:flex;gap:7px;margin-top:14px;flex-wrap:wrap;}
.vote-action{padding:7px 14px;border-radius:7px;border:0.5px solid var(--border2);background:transparent;color:var(--muted);font-family:var(--font);font-size:12px;font-weight:600;cursor:pointer;transition:all 0.18s;display:inline-flex;align-items:center;gap:5px;}
.vote-action:hover:not(:disabled){color:var(--text);border-color:var(--accent);background:var(--accent-glow);}
.vote-action:disabled{opacity:0.35;cursor:not-allowed;}
.vote-action.voted-yes{background:var(--green-bg);border-color:var(--green-border);color:var(--green);}
.vote-action.voted-no{background:var(--red-bg);border-color:rgba(255,82,82,0.3);color:var(--red);}
.vote-action.voted-abs{background:var(--amber-bg);border-color:rgba(255,193,7,0.3);color:var(--amber);}
.tx-link{font-size:11px;font-family:var(--mono);color:var(--accent);text-decoration:none;margin-left:6px;}
.tx-link:hover{text-decoration:underline;}

.gm-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;}
.gm-card{padding:22px 18px;border-radius:14px;border:0.5px solid var(--border);background:var(--bg2);cursor:pointer;transition:all 0.2s;text-align:center;position:relative;overflow:hidden;user-select:none;}
.gm-card::before{content:'';position:absolute;inset:0;opacity:0;transition:opacity 0.2s;}
.gm-card.gm-t::before{background:radial-gradient(circle at 50% 0%,rgba(255,193,7,0.12),transparent 65%);}
.gm-card.gn-t::before{background:radial-gradient(circle at 50% 100%,rgba(91,107,255,0.15),transparent 65%);}
.gm-card:hover{border-color:var(--border2);transform:translateY(-2px);}
.gm-card:hover::before{opacity:1;}
.gm-card:active{transform:scale(0.97);}
.gm-card.off{pointer-events:none;opacity:0.4;}
.gm-emoji{font-size:32px;margin-bottom:10px;display:block;}
.gm-label{font-size:18px;font-weight:800;letter-spacing:-0.5px;}
.gm-card.gm-t .gm-label{color:var(--amber);}
.gm-card.gn-t .gm-label{color:var(--accent);}
.gm-sub{font-size:11px;color:var(--muted);font-family:var(--mono);margin-top:5px;}

.feed-item{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:0.5px solid var(--border);}
.feed-item:last-child{border-bottom:none;}
.feed-av{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.feed-av.gm{background:var(--amber-bg);border:0.5px solid rgba(255,193,7,0.2);}
.feed-av.gn{background:var(--accent-glow);border:0.5px solid rgba(91,107,255,0.2);}
.feed-body{flex:1;min-width:0;}
.feed-msg{font-size:13px;font-weight:700;color:var(--text);}
.feed-hash{font-size:11px;font-family:var(--mono);color:var(--dim);margin-top:1px;}
.feed-hash a{color:var(--accent);text-decoration:none;}
.feed-hash a:hover{text-decoration:underline;}
.feed-time{font-size:11px;font-family:var(--mono);color:var(--muted);flex-shrink:0;}

.tx-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:0.5px solid var(--border);}
.tx-row:last-child{border-bottom:none;}
.tx-pill{font-size:10px;font-family:var(--mono);padding:3px 9px;border-radius:99px;flex-shrink:0;font-weight:500;}
.tx-pill.vote{background:var(--accent-glow);color:var(--accent);border:0.5px solid rgba(91,107,255,0.3);}
.tx-pill.gm,.tx-pill.gn{background:var(--amber-bg);color:var(--amber);border:0.5px solid rgba(255,193,7,0.25);}
.tx-pill.proposal{background:var(--green-bg);color:var(--green);border:0.5px solid var(--green-border);}
.tx-desc{flex:1;font-size:12px;color:var(--muted);min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tx-hash-link{font-size:10px;font-family:var(--mono);color:var(--accent);text-decoration:none;flex-shrink:0;}
.tx-hash-link:hover{text-decoration:underline;}
.tx-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 5px rgba(29,233,182,0.4);flex-shrink:0;}

.toast-wrap{position:fixed;bottom:26px;left:50%;transform:translateX(-50%);z-index:9999;pointer-events:none;}
.toast{padding:10px 20px;border-radius:99px;background:var(--bg3);border:0.5px solid var(--border2);font-size:13px;color:var(--text);font-family:var(--mono);white-space:nowrap;opacity:0;transform:translateY(10px);transition:all 0.3s;}
.toast.show{opacity:1;transform:translateY(0);}
.spin{display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,0.2);border-top-color:currentColor;border-radius:50%;animation:spinning 0.7s linear infinite;vertical-align:-2px;}
@keyframes spinning{to{transform:rotate(360deg)}}
.empty{text-align:center;padding:36px 0;color:var(--dim);font-size:13px;font-family:var(--mono);}

footer{margin-top:auto;padding:28px 0;border-top:0.5px solid var(--border);position:relative;z-index:1;}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.footer-l{font-size:12px;color:var(--dim);font-family:var(--mono);}
.footer-links{display:flex;gap:18px;}
.footer-links a{font-size:12px;color:var(--muted);text-decoration:none;font-family:var(--mono);transition:color 0.2s;}
.footer-links a:hover{color:var(--accent);}
@media(max-width:540px){.share-strip{flex-direction:column;align-items:flex-start;}}
</style>
</head>
<body>
<div class="blob1"></div>
<div class="blob2"></div>

<header>
  <div class="container">
    <div class="header-inner">
      <a class="logo" href="#">
        <div class="logo-mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span class="logo-text">Arc<span>Vote</span></span>
      </a>
      <div class="header-right">
        <div class="net-pill"><span class="dot"></span>Arc Testnet</div>
        <span class="bal-chip" id="balChip">0.00 USDC</span>
        <!-- Web3Modal button — tüm cüzdanları destekler -->
        <w3m-button balance="hide" size="sm"></w3m-button>
      </div>
    </div>
  </div>
</header>

<div class="container">
  <section class="hero">
    <div class="eyebrow">
      <svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4" fill="currentColor"/></svg>
      Built on Arc Network · USDC-native L1
    </div>
    <h1>Your Arc testnet<br/><em>quest hub.</em></h1>
    <p>Track every airdrop-relevant task, verify it straight from the chain, keep your daily GM streak alive and climb the leaderboard — votes, proposals and messages included, ~$0.009 per tx.</p>
    <div class="hero-stats">
      <div><div class="hstat-n" id="hTotalVotes">0</div><div class="hstat-l">Total votes</div></div>
      <div><div class="hstat-n" id="hTotalTx">0</div><div class="hstat-l">Transactions</div></div>
      <div><div class="hstat-n">~$0.009</div><div class="hstat-l">Gas per TX</div></div>
    </div>
  </section>

  <div class="share-strip">
    <div>
      <div class="share-text">Try onchain voting on Arc — USDC gas, sub-second finality.
        <span>arcvote.app · Chain ID 5042002 · built on Arc Network testnet</span>
      </div>
    </div>
    <button class="tweet-btn" onclick="shareOnX()">
      <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      Share on X
    </button>
  </div>

  <div class="tabs-wrap">
    <div class="tabs">
      <button class="tab-btn active" onclick="switchTab('quests',this)">
        <svg viewBox="0 0 24 24"><path d="M12 2l2.4 4.86 5.36.78-3.88 3.78.92 5.34L12 14.24l-4.8 2.52.92-5.34-3.88-3.78 5.36-.78z"/></svg>Quests
      </button>
      <button class="tab-btn" onclick="switchTab('vote',this)">
        <svg viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Vote
      </button>
      <button class="tab-btn" onclick="switchTab('gm',this)">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>GM / GN
      </button>
      <button class="tab-btn" onclick="switchTab('txlog',this)">
        <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>TX Log
      </button>
      <button class="tab-btn" onclick="switchTab('board',this)">
        <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Board
      </button>
      <button class="tab-btn" onclick="switchTab('ranks',this)">
        <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Ranks
      </button>
    </div>
  </div>

  <!-- QUESTS -->
  <div class="section active" id="quests">
    <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:linear-gradient(135deg,rgba(91,107,255,0.12),rgba(29,233,182,0.07));border-color:rgba(91,107,255,0.3);">
      <div>
        <div style="font-size:26px;font-weight:800;" id="streakBig">🔥 Day 0</div>
        <div style="font-size:11px;color:var(--muted);font-family:var(--mono);margin-top:3px;" id="streakSub">GM streak · verified from chain</div>
      </div>
      <div style="text-align:right;">
        <button class="submit-btn" id="dailyBtn" onclick="dailyPack()" disabled>⚡ Do my daily pack</button>
        <div style="font-size:10px;color:var(--muted);font-family:var(--mono);margin-top:6px;">GM + vote · 2 real txs · ~$0.02</div>
      </div>
    </div>

    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
        <div>
