  <!-- RANKS -->
  <div class="section" id="ranks">
    <div class="card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;font-family:var(--mono);">GM Leaderboard · most onchain GMs</span>
        <button class="connect-btn" onclick="loadLeaderboard()" id="lbBtn">↻ Refresh</button>
      </div>
      <div id="lbList"><p class="empty">Loading leaderboard…</p></div>
    </div>
  </div>

  <!-- VOTE -->
  <div class="section" id="vote">
    <div class="stats-bar">
      <div class="stat-card"><div class="stat-n" id="sProposals">3</div><div class="stat-l">Proposals</div></div>
      <div class="stat-card"><div class="stat-n" id="sMyVotes">0</div><div class="stat-l">My votes</div></div>
      <div class="stat-card"><div class="stat-n" id="sTotalVotes">0</div><div class="stat-l">Total cast</div></div>
    </div>
    <div class="new-proposal-card">
      <span class="np-label">+ Submit new proposal on-chain</span>
      <textarea class="text-input" id="proposalInput" rows="2" placeholder="Describe your proposal..."></textarea>
      <button class="submit-btn" id="submitPropBtn" onclick="submitProposal()" disabled>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Submit on-chain
